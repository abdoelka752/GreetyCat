{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greedycat.local/contracts/sync-v1/review.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["review_id", "round_id", "context_id", "mode", "provenance", "round_number", "revision", "previous_id", "value", "observed_at", "confirmed_at", "reviewer_id", "reason", "evidence"],
  "properties": {
    "review_id": {"$ref": "#/$defs/uuid"}, "round_id": {"$ref": "#/$defs/uuid"}, "context_id": {"$ref": "#/$defs/uuid"},
    "mode": {"enum": ["BASIC", "PROFESSIONAL"]}, "provenance": {"enum": ["REAL", "SYNTHETIC"]},
    "round_number": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,31})$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "previous_id": {"anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "value": {"enum": ["CORN", "TOMATO", "CARROT", "PEPPER", "SHRIMP", "COW", "FISH", "CHICKEN", "SALAD", "PIZZA"]},
    "observed_at": {"$ref": "#/$defs/time"}, "confirmed_at": {"$ref": "#/$defs/time"}, "reviewer_id": {"$ref": "#/$defs/uuid"},
    "reason": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "\\S"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "mime", "bytes", "imported_at", "duration_ms", "video_offset_ms"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mime": {"enum": ["image/png", "image/jpeg", "image/webp", "video/mp4", "video/webm"]},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 134217728}, "imported_at": {"$ref": "#/$defs/time"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 1, "maximum": 7200000},
        "video_offset_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 7199999}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "time": {"type": "string", "format": "utc-millis", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
  }
}
