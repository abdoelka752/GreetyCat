{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greedycat.local/contracts/v1/outcome.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "round_id", "context_id", "mode", "provenance", "value", "observed_at", "confidence", "review_status", "confirmed_at", "reviewer_id", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "outcome_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "round_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "context_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "mode": {"$ref": "common.schema.json#/$defs/mode"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "value": {"$ref": "common.schema.json#/$defs/outcome"},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "confidence": {"$ref": "common.schema.json#/$defs/probability"},
    "review_status": {"enum": ["UNREVIEWED", "HUMAN_CONFIRMED"]},
    "confirmed_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]},
    "reviewer_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/uuid"}]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "HUMAN_CONFIRMED"}}},
    "then": {"properties": {"confirmed_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "reviewer_id": {"$ref": "common.schema.json#/$defs/uuid"}, "mode": {"enum": ["BASIC", "PROFESSIONAL"]}}},
    "else": {"properties": {"confirmed_at": {"type": "null"}, "reviewer_id": {"type": "null"}}}
  }]
}
